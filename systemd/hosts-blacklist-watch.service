[Unit]
Description=Monitora o /etc/hosts e reaplica a blacklist quando ele muda
After=local-fs.target

[Service]
Type=simple
ExecStart=@BINDIR@/hosts-blacklist-watch
SyslogIdentifier=hosts-blacklist-watch
Restart=always
RestartSec=5
# 78 = inotifywait ausente: reiniciar não resolve.
RestartPreventExitStatus=78

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
